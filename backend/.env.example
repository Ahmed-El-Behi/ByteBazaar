# Copier ce fichier en .env puis renseigner les valeurs.

# PostgreSQL
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/ByteBazaar?schema=public"

# Clé de signature des sessions (longue chaîne aléatoire, ex. `openssl rand -hex 32`)
JWT_SECRET=""

# Serveur SMTP (Gmail : mot de passe d'application, port 465 en SSL ou 587 en STARTTLS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# URL du frontend : liens des emails + origine autorisée par CORS (plusieurs : séparées par des virgules)
FRONTEND_URL="http://localhost:4200"

# Port de l'API (3000 par défaut)
PORT=3000
